if SHIELD_CORNEY_XIAO_LEFT

    config ZMK_KEYBOARD_NAME
        default "Corney Xiao"

endif #

if SHIELD_CORNEY_XIAO_LEFT || SHIELD_CORNEY_XIAO_RIGHT

    config ZMK_SPLIT
        default y

endif

if SHIELD_CORNEY_XIAO_DONGLE

    config ZMK_KEYBOARD_NAME
        default "Corney Xiao"

    config ZMK_SPLIT_ROLE_CENTRAL
        default y

    config ZMK_SPLIT
        default y

    # Two peripherals: left half and right half
    config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
        default 2

    # ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS (2) + desired BT profiles (5)
    config BT_MAX_CONN
        default 7

    config BT_MAX_PAIRED
        default 7

endif
